# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# This is just an example; you can add more variables as needed.
# AI Assistance Disclosure:
# Tool: GitHub Copilot SDK in VS Code (model: GPT-5.6 Luna), date: 2026-10-12
# Scope: Documented the order-service Redis port used by the BullMQ worker.
# Author review: tng wen xi
# ─────────────────────────────────────────────────────────────

# ---- Global -------------------------------------------------
LOG_LEVEL=

# ---- Auth / JWT -----------
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=
JWT_REFRESH_TOKEN_TTL=

# ... Add more variables as needed

# ---- order-service ------------------------------------------
ORDER_SERVICE_PORT=3002
ORDER_DB_PORT=5433
ORDER_DB_USER=order
ORDER_DB_PASSWORD=order
ORDER_DB_NAME=order_db
ORDER_REDIS_PORT=6379

# ---- credit-service -----------------------------------------
# AI Assistance Disclosure:
# Tool: Claude Code (model: claude-opus-5), date: 2026-09-26
#   2026-09-26: Recess iteration - added the credit-service variables read by
#     compose.yaml. No requirements, architecture, schema, or API decisions were
#     made by the AI tool.
#     Author review:
CREDIT_SERVICE_PORT=3003
CREDIT_DB_PORT=5435
# Owner of the credit-service tables. Used to bootstrap the database and run migrations.
CREDIT_DB_USER=credit
CREDIT_DB_PASSWORD=credit
CREDIT_DB_NAME=credit_db
# Least-privilege role the service connects as (NFR8.2.3): no DELETE anywhere and no
# UPDATE on transaction_log, so a logged credit operation cannot be altered or removed.
# The name must stay credit_app — credit-service/src/db/grants.sql grants to that role.
CREDIT_APP_USER=credit_app
CREDIT_APP_PASSWORD=credit_app

# ---- supplier-service -----------------------------------------
# AI Assistance Disclosure:
# Tool: Claude Code (model: claude-sonnet-5), date: 2026-09-29
#   2026-09-29: Added the supplier-service variables read by compose.yaml, matching
#     supplier-service/.env.example's existing defaults (root user, fixed db name). No
#     requirements, architecture, schema, or API decisions were made by the AI tool.
#     Author review: Congchen
SUPPLIER_SERVICE_PORT=3004
SUPPLIER_DB_PORT=5436
SUPPLIER_DB_PASSWORD=supplier_root_password
