PORT=3003
NODE_ENV=development

# Must match CREDIT_DB_* in the root .env, which compose.yaml feeds to this service.
# Inside Docker the host is the service name; running `npm run dev` on the host instead,
# use DB_HOST=localhost and DB_PORT=5435 (the published port).
DB_HOST=credit-db
DB_PORT=5432
DB_NAME=credit_db
DB_USER=credit
DB_PASSWORD=credit
