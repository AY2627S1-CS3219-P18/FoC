#
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is git-ignored — never commit real secrets.

PORT=3003
NODE_ENV=development

# Must match CREDIT_DB_* in the root .env, which compose.yaml feeds to this service.
# Inside Docker the host is the service name; running `npm run dev` on the host instead,
# use DB_HOST=localhost and DB_PORT=5435 (the published port).
DB_HOST=credit-db
DB_PORT=5432
DB_NAME=credit_db
DB_USER=credit
DB_PASSWORD=credit

# Origin of user-service; the JWKS key set is fetched from
# ${USER_SERVICE_URL}/auth/.well-known/jwks.json
USER_SERVICE_URL=http://localhost:3001

# order-redis, the broker order-service publishes credit_transfer jobs to.
# Inside Docker the host is the service name; running the worker on the host instead,
# order-redis is not published, so see credit-service/README.md.
REDIS_HOST=order-redis
REDIS_PORT=6379
