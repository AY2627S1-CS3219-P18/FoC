# Server
PORT=3001
NODE_ENV=development

# PostgreSQL
DB_HOST=user-db
DB_PORT=5432
DB_NAME=user_service
DB_USER=postgres
DB_PASSWORD=postgres
# true requires TLS with a verified server certificate (the ECS deployment). Off for local use.
DB_SSL=false

# JWT (RS256)
JWT_KEY_ID=2026-10
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
# Only set during a key-rotation overlap window (both together, or neither):
# JWT_PREVIOUS_KEY_ID=2026-07
# JWT_PREVIOUS_PUBLIC_KEY_PATH=./keys/previous-public.pem
ACCESS_TOKEN_TTL_MINUTES=15   # 1-15
REFRESH_TOKEN_TTL_DAYS=30     # 1-30
ELEVATION_TOKEN_TTL_MINUTES=15 # 1-15

# Email (Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Super Admin Bootstrap
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_EMAIL=superadmin@foc.com
SUPER_ADMIN_PASSWORD=

# Optional test user (normal 'user' role). Seeded at startup only if all three are set.
TEST_USER_USERNAME=
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# OTP
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=5
OTP_RESEND_WINDOW_MINUTES=60

# Credit service
CREDIT_SERVICE_URL=http://credit-service:3003

# Login lockout / OTP send escalation (NFR1.1)
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOCK_ESCALATION_HOURS=1,4,24
LOCK_ESCALATION_RESET_HOURS=24

# Frontend
# Frontend must send requests with credentials: 'include'
# Scope (2026-11-09, Claude Code, model: claude-sonnet-5-5): Added DATABASE_URL, read only by
# `npm run db:deploy` (Prisma migrations). No requirements, architecture, schema, or API
# decisions were made by the AI tool. Author review:
# From the host, with Compose publishing Postgres on 5434:
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/user_service
