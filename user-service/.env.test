PORT=3001
NODE_ENV=test

# Test database on the existing user-db instance (host port 5434, see compose.yaml).
DB_HOST=localhost
DB_PORT=5434
DB_NAME=user_service_test
DB_USER=postgres
DB_PASSWORD=postgres

# Key paths are overridden by tests/setup/setupFiles.ts with a throwaway key pair.
JWT_PRIVATE_KEY_PATH=./unused-private.pem
JWT_PUBLIC_KEY_PATH=./unused-public.pem
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Dummy SMTP (required when NODE_ENV is not development). The email service is mocked.
SMTP_HOST=smtp.test.invalid
SMTP_PORT=587
SMTP_USER=test-user
SMTP_PASS=test-pass
SMTP_FROM=noreply@test.invalid

SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_EMAIL=superadmin@foc.test
SUPER_ADMIN_PASSWORD=Test-Admin-Pass1!

OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=5
OTP_RESEND_WINDOW_MINUTES=60
