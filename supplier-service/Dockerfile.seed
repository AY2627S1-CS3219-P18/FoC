# AI Assistance Disclosure:
# Tool: Claude Code (model: claude-opus-5-5), date: 2026-11-06
# Scope: ECS Fargate migration - one-off image for `npm run seed`, per George's ECS Fargate plan, Phase 1
#        item 9. No requirements, architecture, schema, or API decisions were made by the AI tool.
# Author review: George Yeo
#
# Build from the repository root, because the seed reads images from frontend/ and foc-mockup/:
#   docker build -f supplier-service/Dockerfile.seed -t foc-supplier-seed .
# Dockerfile.seed.dockerignore allows only the paths below into the build context.

FROM node:24-alpine
# The seed test finds images at ../../../frontend/public/images, so this keeps the repository layout.
WORKDIR /seed/supplier-service
COPY supplier-service/package.json supplier-service/package-lock.json ./
RUN npm ci
COPY supplier-service/tsconfig.json supplier-service/vitest.seed.config.ts ./
COPY supplier-service/src ./src
COPY supplier-service/test/seed ./test/seed
COPY frontend/public/images /seed/frontend/public/images
COPY foc-mockup/public/images /seed/foc-mockup/public/images
# Trusted through NODE_EXTRA_CA_CERTS, set in the ECS task definition.
ADD --chmod=644 https://truststore.pki.rds.amazonaws.com/ap-southeast-1/ap-southeast-1-bundle.pem /etc/ssl/rds-ap-southeast-1-bundle.pem
CMD ["npm", "run", "seed"]
