{
  "name": "supplier-service",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "tsx src/app.ts",
    "dev": "nodemon -L --watch src --ext ts,json --exec tsx src/app.ts",
    "build": "tsc",
    "test": "vitest",
    "test:minio": "vitest run --config vitest.minio.config.ts",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:phase2": "tsx src/db/migratePhase2.ts",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "express": "^4.21.2",
    "ioredis": "^5.4.1",
    "multer": "^2.4.0",
    "mysql2": "^3.11.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.19.0",
    "vitest": "^5.0.2"
  }
}
