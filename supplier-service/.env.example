# Author review:

PORT=3002
NODE_ENV=development
PER_IP_RATE_LIMIT=20000
DB_HOST=supplier-db
DB_PORT=3306
DB_NAME=supplier_service
DB_USER=root
DB_PASSWORD=supplier_root_password
# true requires TLS with a verified server certificate (the ECS deployment). Off for local use.
DB_SSL=false
REDIS_HOST=supplier-redis
REDIS_PORT=6379
# true connects to Redis over TLS (the ECS deployment). Off for local use.
REDIS_TLS=false
USER_SERVICE_URL=http://user-service:3001
# Alternative to a user JWT on GET /suppliers/:id and GET /suppliers/reference/location, for
# order-service's scheduled-errands worker. Same value as order-service's own secret.
SUPPLIER_ORDER_SERVICE_API_KEY=f08f5b76a31c5fb6b5046e69eb2be667f70ebb3df55ccddc
# Must be the same string in the API and the worker; stored photo locations start with it.
PHOTO_STORE_ENDPOINT=http://host.docker.internal:9000
PHOTO_STORE_BUCKET=supplier-photos
# Leave both keys unset on ECS, where the task role supplies credentials. Set both for MinIO.
PHOTO_STORE_ACCESS_KEY=photostoredev
PHOTO_STORE_SECRET_KEY=photostoredev-secret
# Required by the S3 SDK; MinIO ignores it. Set to the bucket's region for AWS S3.
PHOTO_STORE_REGION=us-east-1
MOCK_DOWNSTREAM_FAILURE=false
