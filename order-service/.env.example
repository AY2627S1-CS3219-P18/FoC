# Used when running the service directly on your machine (npm run start:dev).
# Copy to `.env`:  cp .env.example .env
# In Docker, these are injected by ../compose.yaml instead.

NODE_ENV=development
PORT=3002

# Points at the order-db container's published port (ORDER_DB_PORT in ../.env).
DATABASE_URL=postgresql://order:order@localhost:5433/order_db
