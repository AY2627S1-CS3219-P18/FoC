# Used when running the service directly on your machine (npm run start:dev).
# Copy to `.env`:  cp .env.example .env
# In Docker, these are injected by ../compose.yaml instead.

NODE_ENV=development
PORT=3002

# Points at the order-db container's published port (ORDER_DB_PORT in ../.env).
DATABASE_URL=postgresql://order:order@localhost:5433/order_db
USER_SERVICE_URL=http://localhost:3001

# Scheduled-errands worker only, for the fire-time user check (GET /users/worker/:id). Same
# value as user-service's own USER_ORDER_SERVICE_API_KEY.
USER_ORDER_SERVICE_URL=http://localhost:3001
USER_ORDER_SERVICE_API_KEY=replace-with-user-order-service-secret

# BullMQ / outbox worker (order-redis). Defaults match a local Redis.
REDIS_HOST=localhost
REDIS_PORT=6379
# true connects to Redis over TLS (the ECS deployment). Off for local use.
REDIS_TLS=false

# credit-service base URL: the API reserves on create; the worker releases.
CREDIT_SERVICE_URL=http://localhost:3003

# supplier-service base URL, for checking supplier / delivery-location ids on create and edit.
SUPPLIER_SERVICE_URL=http://localhost:3004

# Scheduled-errands worker only, for the fire-time supplier/location check. Same value as
# supplier-service's own SUPPLIER_ORDER_SERVICE_API_KEY.
SUPPLIER_ORDER_SERVICE_API_KEY=replace-with-supplier-order-service-secret

# Worker only: bull-board queue dashboard at http://localhost:<port>/admin/queues.
# Leave unset to disable it.
QUEUE_DASHBOARD_PORT=3010

# Chat delivery worker; use the same key as Chat Service.
CHAT_SERVICE_URL=http://localhost:3005
CHAT_SERVICE_API_KEY=replace-with-shared-chat-service-key
