// Order service Prisma schema.
// Datasource URL is supplied by prisma.config.ts (Prisma 7 no longer reads it here).

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

