// Order service Prisma schema.
// Datasource URL is supplied by prisma.config.ts (Prisma 7 no longer reads it here).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  pending
  open
  accepted
  picked_up
  delivered
  completed
  cancelled
  expired
  failed
}

model OrderRequest {
  id                 String        @id @default(uuid(7)) @db.Uuid
  requesterId        String        @db.Uuid
  supplierId         Int
  description        String
  deliveryLocationId Int // supplier-service location_id
  credits            Int
  completeBy         DateTime?     @db.Timestamptz(3) // null = no deadline
  additionalDetails  String?
  courierId          String?       @db.Uuid
  status             RequestStatus @default(open)
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(3)
  acceptedAt         DateTime?     @db.Timestamptz(3)
  deliveredAt        DateTime?     @db.Timestamptz(3)
  creditReleasedAt   DateTime?     @db.Timestamptz(3)
  version            Int           @default(0)

  @@index([status, createdAt])
  @@index([requesterId])
  @@index([courierId])
  @@index([credits])
  @@index([completeBy])
  @@index([deliveryLocationId])
  @@map("requests")
}

// Background tasks committed in the same transaction as the order write; the
// worker's relay adds each row to BullMQ and deletes it once added.
model Outbox {
  id       BigInt @id @default(autoincrement())
  taskName String
  payload  Json
  version  Int // the order version written by the same transaction

  @@map("outbox")
}

// BullMQ jobs that exhausted their retries (or could not be routed).
model DeadLetterJob {
  id         BigInt   @id @default(autoincrement())
  jobId      String
  taskName   String
  payload    Json
  errorTrace String
  failedAt   DateTime @db.Timestamptz(3)
  status     String   @default("UNRESOLVED")

  @@index([status])
  @@map("dead_letter_jobs")
}
