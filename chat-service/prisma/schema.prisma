generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}
datasource db {
  provider = "mysql"
}
enum ConversationStatus {
  ACTIVE
  ARCHIVED
}
enum ParticipantRole {
  REQUESTER
  COURIER
}
model Conversation {
  conversationId String @id @default(uuid()) @map("conversation_id") @db.Char(36)
  orderId String? @unique(map: "chats_order_id_key") @map("order_id") @db.Char(36)
  title String @map("chat_title") @db.Text
  status ConversationStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @default(now()) @map("updated_at") @db.DateTime(3)
  participants ChatParticipant[]
  systemChat SystemChat?
  messages Message[]
  @@index([updatedAt, conversationId], map: "chats_updated_at_conversation_id_idx")
  @@map("conversations")
}
model ChatParticipant {
  id String @id @default(uuid()) @db.Char(36)
  chatId String @map("chat_id") @db.Char(36)
  userId String @map("user_id") @db.Char(36)
  role ParticipantRole?
  lastReadMessageId String? @map("last_read_message_id") @db.Char(36)
  joinedAt DateTime @default(now()) @map("joined_at") @db.DateTime(3)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(3)
  conversation Conversation @relation(fields: [chatId], references: [conversationId], onDelete: Restrict, onUpdate: Restrict, map: "chat_participants_chat_id_fkey")
  @@map("conversation_participants")
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  SYSTEM
}
model Message {
  id String @id @default(uuid()) @db.Char(36)
  chatId String @map("chat_id") @db.Char(36)
  senderId String? @map("sender_id") @db.Char(36)
  type MessageType
  content String? @db.Text
  triggeredByUserId String? @map("triggered_by_user_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  conversation Conversation @relation(fields: [chatId], references: [conversationId], onDelete: Restrict, onUpdate: Restrict)
  @@map("messages")
}

model SystemChat {
  userId String @id @map("user_id") @db.Char(36)
  conversationId String @unique @map("conversation_id") @db.Char(36)
  conversation Conversation @relation(fields: [conversationId], references: [conversationId], onDelete: Cascade, onUpdate: Cascade)
  @@map("system_chats")
}
