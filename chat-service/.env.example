PORT=3000
DATABASE_URL=mysql://chat:password@localhost:3306/chat_service
# true requires TLS with a verified server certificate (the ECS deployment). Off for local use.
DB_SSL=false
CHAT_SERVICE_API_KEY=replace-with-service-secret

# Run node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# to generate a secret

USER_SERVICE_URL=http://localhost:3001

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS=false
