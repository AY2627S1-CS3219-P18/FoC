# Author review:
PORT=3000
DATABASE_URL=mysql://chat:password@localhost:3306/chat_service
CHAT_SERVICE_API_KEY=replace-with-service-secret

# Verified TLS to MySQL for the app. On AWS, also set NODE_EXTRA_CA_CERTS to the RDS CA file, and add
# ?sslaccept=strict&sslcert=/etc/ssl/rds-ap-southeast-1-bundle.pem to DATABASE_URL so
# `prisma migrate deploy` uses TLS as well.
DB_SSL=false

# Run node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# to generate a secret

USER_SERVICE_URL=http://localhost:3001

# Scope (2026-11-09, Claude Code, model: claude-sonnet-5-5): Added translation LLM settings.
# Author review: Congchen
TRANSLATION_LLM_KEY=replace-with-google-ai-studio-key
TRANSLATION_LLM_MODEL=gemini-3.1-flash-lite

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS=false
